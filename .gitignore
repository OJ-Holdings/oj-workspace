node_modules/
.next/
.env*
!.env.example
*.tsbuildinfo
test-results/

# Local Netlify folder
.netlify

# Never commit customer database backup archives or their manifests
supabase-*.dump
supabase-*.dump.partial
supabase-*.dump.manifest.json

# Encrypted backup secrets and private recovery files must never enter git.
*.age
*.dpapi
scripts/**/__pycache__/
.env
google-oauth-client.json
backups/

# Google service account keys live OUTSIDE the repo (see .env.example). These catch a
# key dropped in here by mistake, including Google's default name oj-automations-<id>.json.
*service-account*.json
*service_account*.json
*serviceaccount*.json
oj-automations-*.json
*-key.json
*.pem
*.p12
.secrets/
secrets/
keys/
