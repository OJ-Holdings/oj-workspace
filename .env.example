# Copy to .env.local and fill in. NEVER commit .env.local.
# Names only -- no real values belong in this file.

# --- Workspace (public values; safe in the browser) ---
# Leave blank to use the defaults in src/lib/oj-connection.ts.
NEXT_PUBLIC_OJ_SUPABASE_URL=
NEXT_PUBLIC_OJ_SUPABASE_PUBLISHABLE_KEY=
# The exact https address this app is served from.
OJ_WORKSPACE_URL=

# --- OJ Essentials: Shopify (server only) ---
# From a Dev Dashboard app installed on the store with read-only scopes.
# The server swaps these for a short-lived token; see docs/CONNECTIONS.md.
# The domain is the .myshopify.com one, not ojessentials.store.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- OJ Solutions: GoHighLevel (server only) ---
# Private integration token (read-only scopes) and the sub-account's location id.
GHL_ACCESS_TOKEN=
GHL_LOCATION_ID=

# --- OJ Exterior Care: existing oj-sms-system server (server only) ---
# Used only to ask that server to send a text. This app never sends texts itself.
# The URL is enough for its texting routes; the key is only sent if set.
# While the server runs on the same PC: http://127.0.0.1:3001
EXTERIOR_API_URL=
EXTERIOR_API_KEY=
