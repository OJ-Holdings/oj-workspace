# Copy to .env.local and fill in. NEVER commit .env.local.
# Names only -- no real values belong in this file.

# --- Workspace (public values; safe in the browser) ---
# Leave blank to use the defaults in src/lib/oj-connection.ts.
NEXT_PUBLIC_OJ_SUPABASE_URL=
NEXT_PUBLIC_OJ_SUPABASE_PUBLISHABLE_KEY=
# The exact https address this app is served from.
OJ_WORKSPACE_URL=

# --- OJ Solutions email engine (server only: Windows .env.local or Netlify settings) ---
# The mailing address printed at the bottom of every cold email. US law (CAN-SPAM) requires one.
# The engine refuses to send while this is empty. It reuses the sync token and organization id below.
OJ_EMAIL_POSTAL_ADDRESS=
OJ_EMAIL_COMPANY=OJ Solutions

# --- OJ Solutions outreach ingest (Netlify server only) ---
# Random bearer token shared only with the bound Google Apps Script sender.
OJ_OUTREACH_SYNC_TOKEN=
OJ_OUTREACH_ORGANIZATION_ID=
# Used only by netlify/functions/daily-outreach-sync.ts, the LSA poller on the Windows host
# and the founder-run `npm run lsa` scripts. Never by anything a signed-in person triggers.
OJ_SUPABASE_SERVICE_ROLE_KEY=

# --- OJ Exterior Care: Local Services Ads lead engine (server only) ---
# Full (absolute) path to the service account's JSON key, kept OUTSIDE the repo, e.g.
# C:/Users/<you>/.secrets/oj-workspace/lsa-service-account.json. Absolute because the
# Windows host deploys into fresh release folders and copies only .env.local into them.
# The service account is added in Google Ads (Admin > Access and security > Users, Read only).
GOOGLE_ADS_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_ADS_LSA_CUSTOMER_ID=
# The manager account the service account was added to: 10 digits, no hyphens.
# The sync drops it if Google refuses it.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# The workspace id the Exterior Care leads belong to (falls back to OJ_OUTREACH_ORGANIZATION_ID).
OJ_EXTERIOR_ORGANIZATION_ID=
# "on" only on the one host that polls Google every 10 minutes (the Windows host).
# The poller and the lsa scripts use OJ_SUPABASE_SERVICE_ROLE_KEY above; Sync now uses the person's own session.
LSA_POLL=

# --- OJ Essentials: Shopify (server only) ---
# From a Dev Dashboard app installed on the store with read-only scopes.
# The server swaps these for a short-lived token; see docs/CONNECTIONS.md.
# The domain is the .myshopify.com one, not ojessentials.store.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- OJ Solutions: GoHighLevel (server only) ---
# Private integration token (read-only scopes) and the sub-account's location id.
GHL_ACCESS_TOKEN=
GHL_LOCATION_ID=

# --- Mercury banking (read-only, server only, owner-only in Finance) ---
# Create a Mercury API token with the Read Only role. Never use a payment-capable token here.
OJ_MERCURY_API_TOKEN=
